@startuml Ressourcix_Class_Diagram_Flat
title Ressourcix - Klassendiagramm (Flach)

' Styling
skinparam class {
    BackgroundColor<<singleton>> LightYellow
    BackgroundColor<<domain>> LightBlue
    BackgroundColor<<gui>> LightGreen
    BackgroundColor<<popup>> LightCoral
    BackgroundColor<<enum>> Wheat
    BorderColor Black
}

skinparam object {
    BackgroundColor<<singleton>> LightYellow
    BackgroundColor<<domain>> LightBlue
    BackgroundColor<<gui>> LightGreen
    BackgroundColor<<popup>> LightCoral
    BorderColor Black
}

skinparam arrowColor Black
skinparam arrowThickness 1.5

' Abstände
skinparam nodesep 80
skinparam ranksep 100

' ========================================
' LEGENDE
' ========================================

legend top left
|= **Farben** |= **Bedeutung** |
| <back:LightYellow>Gelb</back> | Singleton |
| <back:LightBlue>Blau</back> | Domain |
| <back:LightGreen>Grün</back> | GUI |
| <back:LightCoral>Rosa</back> | PopUp |
| <back:Wheat>Beige</back> | Enum |

|= **Beziehungen** |
| ──> Verwendung |
| *──> Komposition |
| o──> Aggregation |

**Glossar:**
• **object**: Kotlin-Singleton (nur eine Instanz)
• **class**: Normale Klasse (mehrere Instanzen möglich)
• **Singleton**: Muster mit nur einer Instanz
• **Domain**: Geschäftslogik-Klassen
• **GUI**: Benutzeroberfläche-Komponenten
• **PopUp**: Dialog-Fenster
• **Enum**: Aufzählung fester Werte
• **Komposition**: Starke Zugehörigkeit (Teil-von)
• **Aggregation**: Schwache Zugehörigkeit (hat-ein)
endlegend

' ========================================
' DOMAIN - Core Classes
' ========================================

class Employee <<domain>> {
    - id: UInt
    - firstName: String
    - lastName: String
    - workloadPercent: UByte
    - role: Role
    - abbreviation: String
    - department: Department?
    - education: Education?
    - birthday: LocalDate?
    - city: String
    - vacationLimit: UInt
    - vacationEntries: MutableList<VacationEntry>
    - vacationList: MutableList<Int>
    --
    + getId(): UInt
    + getFirstName(): String
    + getLastName(): String
    + getWorkloadPercent(): UByte
    + getRole(): Role
    + getDepartment(): Department?
    + getEducation(): Education?
    + getBirthday(): LocalDate?
    + getCity(): String
    + getVacationLimit(): UInt
    + getFullName(): String
    + abbreviationSting(): String
    + getBirthdayAsString(): String
    + getAbbreviation(): String
    + getVacationByIndex(index: Int): Int
    + setFirstName(value: String)
    + setLastName(value: String)
    + setWorkloadPercent(value: UByte)
    + setRole(value: Role)
    + setDepartment(value: Department?)
    + setEducation(value: Education?)
    + setCity(value: String)
    + setVacationLimit(limit: UInt)
    + setBirthdayFromString(value: String)
    + addVacationEntry(entry: VacationEntry)
    + removeVacationEntry(vacationId: UInt, entry: VacationEntry)
    + removeByStartWeek(startWeek: UInt): Boolean
    + checkVacationLimits(entry: VacationEntry): Boolean
    + createVacationList()
    + getIdWithStartWeek(startWeek: UInt): UInt?
}

class VacationEntry <<domain>> {
    + id: UInt
    + employeeId: UInt
    + year: UInt
    + range: WeekRange
    + status: VacationStatus
    - statusByWeek: MutableMap<UInt, VacationStatus>
    --
    + hasWeek(week: UInt): Boolean
    + getStatus(week: UInt): VacationStatus?
    + setStatus(week: UInt, status: VacationStatus)
    + toString(): String
}

class WeekRange <<domain>> {
    + startWeek: UInt
    + endWeek: UInt
    --
    + contains(week: UInt): Boolean
    + overlaps(other: WeekRange): Boolean
}

class EmployeeManagement <<domain>> {
    + employees: MutableList<Employee>
    - overlapList: MutableList<Int>
    + maxOverlapsPerKw: Int
    + year: UInt
    --
    + listAll(): List<Employee>
    + add(employee: Employee)
    + removeById(id: UInt): Boolean
    + findById(id: UInt): Employee?
    + canAddVacation(employee: Employee, startWeek: UInt, endWeek: UInt): Boolean
    + addVacationSafe(employee: Employee, startWeek: UInt, endWeek: UInt): Boolean
    + removeVacation(empId: UInt, startWeek: UInt, endWeek: UInt)
    + updateOverlapList()
    + countAllOverlaps(): Int
    + getEmployeesInWeek(week: Int): List<Employee>
    + getEmployeeByIndex(index: Int): Employee
    + getOverlapList(): List<Int>
    + allVacationInKwFiltern()
}

' Enumerations
enum Role <<enum>> {
    APPRENTICE
    STAFF
    TEAM_LEAD
    MANAGER
    --
    + displayName: String
    + toString(): String
}

enum VacationStatus <<enum>> {
    REQUESTED
    APPROVED
    REJECTED
    --
    + code: String
}

enum Department <<enum>> {
    AUSSENDIENST
    ADMIN
    PLANUNG
    --
    + displayName: String
    + toString(): String
}

enum Education <<enum>> {
    LEHRLING
    EFZ
    DIPLOM_PFLEGE_HF
    --
    + displayName: String
    + toString(): String
}

' Configuration
object config <<singleton>> {
    + {static} minEmployeeNumber: Int
    + {static} minApprenticeNumber: Int
    + {static} minManagerNumber: Int
    + {static} vacation25Years: Int
    + {static} vacationOver25Years: Int
    + {static} vacationOver50Years: Int
    + {static} vacationBlock: BooleanArray
    + {static} vacationSchoolBlock: BooleanArray
}

' ========================================
' APPLICATION - Core
' ========================================

object app <<singleton>> {
    + {static} management: EmployeeManagement
    + {static} employees: MutableList<Employee>
    + {static} employeeIds: IdProvider
    + {static} vacationIds: IdProvider
    + {static} jasonFileAktiv: Boolean
    --
    + {static} run()
}

class IdProvider {
    - start: UInt
    - nextId: UInt
    - id: UInt
    - issuedIds: MutableSet<UInt>
    --
    + generateId(): UInt
    + getIssuedIds(): Set<UInt>
    + getNextId(): UInt
    + isIssued(id: UInt): Boolean
    + restore(state: IdState)
}

class IdState {
    + nextId: UInt
    + issuedIds: List<UInt>
}

object jsonReader <<singleton>> {
    - {static} jsonDir: File
    --
    + {static} read(): List<Employee>
    + {static} readConfig()
    - {static} extractJsonObjects(json: String): List<String>
    - {static} parseJsonObject(jsonObj: String): Map<String, String>
    - {static} parseBooleanArray(arrayStr: String): BooleanArray
}

object jsonWriter <<singleton>> {
    - {static} jsonDir: File
    - {static} jsonToFile: Boolean
    --
    + {static} write()
    - {static} escapeJson(text: String): String
}

object logger <<singleton>> {
    - {static} currentLevel: Level
    - {static} logToFile: Boolean
    - {static} logToConsole: Boolean
    - {static} logDir: File
    - {static} logBuffer: ConcurrentLinkedQueue<LogEntry>
    - {static} maxBufferSize: Int
    - {static} dateFormatter: DateTimeFormatter
    - {static} fileDateFormatter: DateTimeFormatter
    --
    + {static} debug(message: String, exception: Throwable?)
    + {static} info(message: String, exception: Throwable?)
    + {static} warn(message: String, exception: Throwable?)
    + {static} error(message: String, exception: Throwable?)
    + {static} fatal(message: String, exception: Throwable?)
    + {static} setLevel(level: Level)
    + {static} setFileLogging(enabled: Boolean)
    + {static} setConsoleLogging(enabled: Boolean)
    + {static} getLastLogMessage(): String?
    + {static} getLastLogEntry(): LogEntry?
    + {static} getLastLogMessageWithTimestamp(format: String): String?
    - {static} log(level: Level, message: String, exception: Throwable?)
    - {static} addToBuffer(entry: LogEntry)
    - {static} printToConsole(entry: LogEntry)
    - {static} writeToFile(entry: LogEntry)
}

class "logger.LogEntry" as LogEntry {
    + timestamp: LocalDateTime
    + level: Level
    + message: String
    + exception: Throwable?
    + threadName: String
    + className: String?
    --
    + toFormattedString(): String
}

enum "logger.Level" as LogLevel <<enum>> {
    DEBUG
    INFO
    WARN
    ERROR
    FATAL
}

' ========================================
' GUI - Main
' ========================================

class GuiBorderPane <<gui>> {
    --
    + start(stage: Stage)
    + exit()
}

class StartAnimation <<gui>> {
    --
    + start(primaryStage: Stage)
    + init()
}

class SplashScreenAdvanced <<gui>> {
    - stage: Stage
    - root: StackPane
    - title: Text
    - gradient: LinearGradient
    --
    + show()
    + close()
    - setupStage()
    - createTitle()
    - startAnimation()
    - fadeOut()
}

class NavigationsController <<gui>> {
    - root: BorderPane
    - cache: MutableMap<Route, Node>
    --
    + navigate(to: Route)
    - createView(route: Route): Node
}

enum Route <<enum>> {
    DASHBOARD
    CALENDER
    EMPLOYEEMANAGEMENT
    PARAMETER
}

object topNavigationBar <<singleton>> {
    - {static} dashboardBtn: Button
    - {static} calenderBtn: Button
    - {static} employeeManagementBtn: Button
    - {static} parameterBtn: Button
    - {static} version: Text
    - {static} spacer: Region
    - {static} navBar: HBox
    --
    + {static} bind(router: NavigationsController)
    + {static} getView(): HBox
    - {static} createNavButton(text: String): Button
    - {static} setActive(activeBtn: Button)
    - {static} baseButtonStyle(): String
    - {static} hoverButtonStyle(): String
    - {static} activeButtonStyle(): String
}

object bottomBar <<singleton>> {
    - {static} statusField: TextField
    - {static} clockLabel: Label
    - {static} bar: HBox
    - {static} lastMessage: String
    - {static} clockTimeline: Timeline
    --
    + {static} updateStatusIfChanged()
    + {static} getView(): HBox
    - {static} updateClock()
    - {static} createStatusField(): TextField
    - {static} createClockLabel(): Label
    - {static} createBar(): HBox
}

