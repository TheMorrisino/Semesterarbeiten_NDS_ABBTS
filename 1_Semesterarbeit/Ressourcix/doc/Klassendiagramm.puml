@startuml Ressourcix_Class_Diagram_Vertical

skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
skinparam defaultFontSize 10

' Vertikales Layout
top to bottom direction

' ==================== Main Entry Point ====================
class Main <<(M, orchid)>> {
    + main()
}

' ==================== App Layer ====================

    object app {
        + management: EmployeeManagement
        + employees: MutableList<Employee>
        + employeeIds: IdProvider
        + vacationIds: IdProvider
        + jasonFileAktiv: Boolean
        --
        + run()
    }


' ==================== GUI Layer ====================


    class GuiBorderPane {
        - btnSave: ButtonType
        - btNotSave: ButtonType
        - btnCancel: ButtonType
        --
        + start(stage: Stage)
        + exit()
    }

    object bottomBar {
        - status: TextField
        - clockLabel: Label
        - bar: HBox
        --
        + getView(): HBox
        - updateClock()
        - updateStatus()
    }

    object topNavigationBar {
        + getView(): Node
        + bind(router)
    }


' ==================== Domain Layer ====================


    together {
        class EmployeeManagement {
            + employees: MutableList<Employee>
            - overlapList: MutableList<Int>
            + maxOverlapsPerKw: Int
            + year: UInt
            --
            + add(employee: Employee)
            + removeById(id: UInt): Boolean
            + findById(id: UInt): Employee?
            + addVacationSafe(...)
            + updateOverlapList()
            + countAllOverlaps(): Int
            + getEmployeesInWeek(week: Int)
        }

        class Employee {
            - id: UInt
            - firstName: String
            - lastName: String
            - workloadPercent: UByte
            - role: Role
            - vacationEntries: MutableList<VacationEntry>
            - vacationList: MutableList<Int>
            - department: Department?
            - education: Education?
            - birthday: LocalDate?
            - vacationLimit: UInt
            --
            + getId(): UInt
            + getFullName(): String
            + addVacationEntry(entry)
            + removeVacationEntry(...)
            + createVacationList()
        }


    class VacationEntry {
        + id: UInt
        + employeeId: UInt
        + year: UInt
        + range: WeekRange
        - statusByWeek: Map<UInt, VacationStatus>
        --
        + hasWeek(week: UInt): Boolean
        + getStatus(week: UInt): VacationStatus?
        + setStatus(week, status)
    }

    class WeekRange {
        + startWeek: UInt
        + endWeek: UInt
        --
        + contains(week: UInt): Boolean
        + overlaps(other: WeekRange): Boolean
    }

    together {
        enum Role {
            APPRENTICE
            STAFF
            TEAM_LEAD
            MANAGER
        }

        enum VacationStatus {
            REQUESTED
            APPROVED
            GENERATED
            REJECTED
            CANCELLED
        }

        enum Department {
            AUSSENDIENST
            ADMIN
            PLANUNG
        }

        enum Education {
            LEHRLING
            EFZ
            DIPLOM_PFLEGE_HF
        }

        enum OverlapStatus {
            OK
            WARNING
            CRITICAL
        }
    }

    object vacationPlanner {
        + generateForAll(...)
    }

    object config {
        + minEmployeeNumber: Int
        + vacation25Years: Int
        + vacationBlock: BooleanArray
        + vacationSchoolBlock: BooleanArray
    }
}

' ==================== Essential Layer ====================


    class IdProvider {
        + start: UInt
        - nextId: UInt
        - issuedIds: MutableSet<UInt>
        --
        + generateId(): UInt
        + getIssuedIds(): Set<UInt>
        + restore(state: IdState)
    }

    class IdState <<data class>> {
        + nextId: UInt
        + issuedIds: List<UInt>
    }

    object jsonReader {
        - jsonDir: File
        --
        + read(): List<Employee>
        + readConfig()
    }

    object jsonWriter {
        - jsonDir: File
        --
        + write()
    }


' ==================== Logger Layer ====================


    object logger {
        - currentLevel: Level
        - logBuffer: Queue<LogEntry>
        --
        + debug(message, exception?)
        + info(message, exception?)
        + warn(message, exception?)
        + error(message, exception?)
        + fatal(message, exception?)
        + getLastLogEntry(): LogEntry?
    }

    class LogEntry <<data class>> {
        + timestamp: LocalDateTime
        + level: Level
        + message: String
        + exception: Throwable?
        --
        + toFormattedString(): String
    }

    enum Level {
        DEBUG
        INFO
        WARN
        ERROR
        FATAL
    }


' ==================== Relationships ====================

' Main connections
Main .down.> GuiBorderPane : startet
Main .down.> app : startet
Main .down.> logger : konfiguriert

' App layer
app -down-> EmployeeManagement : verwendet
app -down-> IdProvider : verwendet\n(2 Instanzen)

' GUI layer
GuiBorderPane .down.> app : verwendet
bottomBar .down.> logger : liest Logs

' Domain relationships (vertical)
EmployeeManagement "1" o-down- "0..*" Employee : verwaltet
Employee "1" *-down- "0..*" VacationEntry : enthält
VacationEntry *-down- "1" WeekRange : enthält

' Domain relationships (horizontal)
Employee -right-> Role : hat
Employee -right-> Department : hat
Employee -right-> Education : hat
VacationEntry -right-> VacationStatus : hat

' Essential layer
IdProvider -down-> IdState : stellt wieder her
jsonReader .up.> Employee : erstellt
jsonReader .up.> config : konfiguriert
jsonWriter .up.> Employee : serialisiert
jsonWriter .up.> config : serialisiert

' Logger relationships
logger -right-> LogEntry : erstellt
LogEntry -right-> Level : verwendet

' Cross-layer dependencies
jsonReader -up-> EmployeeManagement : lädt Daten
jsonWriter -up-> EmployeeManagement : speichert Daten

@enduml