@startuml Ressourcix_Class_Diagram_Complete

skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
skinparam defaultFontSize 10

' Vertikales Layout
top to bottom direction

' ==================== Main Entry Point ====================
class Main <<(M, orchid)>> {
    + app.run()
    +  Application.launch(StartAnimation::class.java)

}

' ==================== App Layer ====================

object app {
    + management: EmployeeManagement
    + employees: MutableList<Employee>
    + employeeIds: IdProvider
    + vacationIds: IdProvider
    + jasonFileAktiv: Boolean
    --
    + run()
}

' ==================== GUI Layer ====================

class GuiBorderPane {
    - btnSave: ButtonType
    - btNotSave: ButtonType
    - btnCancel: ButtonType
    --
    + start(stage: Stage)
    + exit()
}

object bottomBar {
    - status: TextField
    - clockLabel: Label
    - bar: HBox
    - statusUpdateThread: Thread
    --
    + getView(): HBox
    - updateClock()
    - updateStatus()
}

object topNavigationBar {
    + getView(): Node
    + bind(router)
}

' ==================== GUI Pages ====================

object dashboardView {
    - barChart: BarChart
    - pieChart: PieChart
    - chartContainer: VBox
    - showingBarChart: Boolean
    --
    + updateBarChart()
    + updatePieChart()
    - toggleChart()
    - refreshCurrentChart()
}

object calenderView {
    - calendarGrid: GridPane
    - selectedEmployee: Employee?
    --
    + refreshVacations()
    + selectEmployee(emp)
    - createCalendarGrid()
}

object employeeView {
    - employeeTable: TableView<Employee>
    - selectedEmployee: Employee?
    --
    + refreshEmployees()
    + addEmployee()
    + editEmployee()
    + deleteEmployee()
}

object logView {
    - tableView: TableView<LogEntry>
    - searchField: TextField
    - levelFilter: ComboBox
    --
    + refreshLogs()
    - searchLogs()
    - exportLogs()
}

' ==================== Splash Screen ====================

class StartAnimation {
    start(primaryStage: Stage)

}

class SplashScreenAdvanced {
    - stage: Stage
    - letters: List<Text>
    --
    + show()
    + close()
    - startAnimation()
}

' ==================== Domain Layer ====================

together {
    class EmployeeManagement {
        + employees: MutableList<Employee>
        - overlapList: MutableList<Int>
        + maxOverlapsPerKw: Int
        + year: UInt
        --
        + add(employee: Employee)
        + removeById(id: UInt): Boolean
        + findById(id: UInt): Employee?
        + addVacationSafe(...)
        + updateOverlapList()
        + countAllOverlaps(): Int
        + getEmployeesInWeek(week: Int)
        + getOverlapList(): List<Int>
    }

    class Employee {
        - id: UInt
        - firstName: String
        - lastName: String
        - workloadPercent: UByte
        - role: Role
        - vacationEntries: MutableList<VacationEntry>
        - vacationList: MutableList<Int>
        - department: Department?
        - education: Education?
        - birthday: LocalDate?
        - vacationLimit: UInt
        --
        + getId(): UInt
        + getFullName(): String
        + addVacationEntry(entry)
        + removeVacationEntry(...)
        + createVacationList()
        + getVacationEntries(): List<VacationEntry>
        + getVacationLimit(): UInt
    }

    class VacationEntry {
        + id: UInt
        + employeeId: UInt
        + year: UInt
        + range: WeekRange
        - statusByWeek: Map<UInt, VacationStatus>
        --
        + hasWeek(week: UInt): Boolean
        + getStatus(week: UInt): VacationStatus?
        + setStatus(week, status)
    }

    class WeekRange {
        + startWeek: UInt
        + endWeek: UInt
        --
        + contains(week: UInt): Boolean
        + overlaps(other: WeekRange): Boolean
    }

    together {
        enum Role {
            APPRENTICE
            STAFF
            TEAM_LEAD
            MANAGER
        }

        enum VacationStatus {
            REQUESTED
            APPROVED
            GENERATED
            REJECTED
            CANCELLED
        }

        enum Department {
            AUSSENDIENST
            ADMIN
            PLANUNG
        }

        enum Education {
            LEHRLING
            EFZ
            DIPLOM_PFLEGE_HF
        }

        enum OverlapStatus {
            OK
            WARNING
            CRITICAL
        }
    }


    object config {
        + minEmployeeNumber: Int
        + vacation25Years: Int
        + vacationBlock: BooleanArray
        + vacationSchoolBlock: BooleanArray
        + maxOverlapsPerWeek: Int
    }
}

' ==================== Essential Layer ====================

class IdProvider {
    + start: UInt
    - nextId: UInt
    - issuedIds: MutableSet<UInt>
    --
    + generateId(): UInt
    + getIssuedIds(): Set<UInt>
    + restore(state: IdState)
}

class IdState <<data class>> {
    + nextId: UInt
    + issuedIds: List<UInt>
}

object jsonReader {
    - jsonDir: File
    --
    + read(): List<Employee>
    + readConfig()
    + readEmployeeManagement()
}

object jsonWriter {
    - jsonDir: File
    --
    + write()
    + writeConfig()
    + writeEmployeeManagement()
}

' ==================== Logger Layer ====================

object logger {
    - currentLevel: Level
    - logBuffer: ConcurrentLinkedQueue<LogEntry>
    - logDir: File
    - maxBufferSize: Int
    --
    + debug(message, exception?)
    + info(message, exception?)
    + warn(message, exception?)
    + error(message, exception?)
    + fatal(message, exception?)
    + getLastLogEntry(): LogEntry?
    + getLastLogMessage(): String?
    + getLastLogMessageWithTimestamp(): String?
    + getAllLogs(): List<LogEntry>
    + searchLogs(text): List<LogEntry>
    + clearBuffer()
}

class LogEntry <<data class>> {
    + timestamp: LocalDateTime
    + level: Level
    + message: String
    + exception: Throwable?
    + threadName: String
    + className: String?
    --
    + toFormattedString(): String
}

enum Level {
    DEBUG
    INFO
    WARN
    ERROR
    FATAL
}



' ==================== Navigation ====================

object NavigationsController {
    - currentView: Node?
    --
    + navigate(target: NavigationTarget)
    + createView(target)
}

enum NavigationTarget {
    DASHBOARD
    CALENDAR
    EMPLOYEES
    LOGS
}

' ==================== Data Classes ====================

package "Statistics" {
    class WeekInfo <<data class>> {
        - count: Int
        - employees: List<String>
    }

    class VacationStats <<data class>> {
        - used: Int
        - available: Int
        - withVacation: List<String>
        - withoutVacation: List<String>
    }
}

' ==================== Relationships ====================

' Main connections
Main .down.> app : startet...
Main .down.> StartAnimation : zeigt zuerst

' Splash Screen
SplashScreenAdvanced .down.> GuiBorderPane : startet nach Animation
StartAnimation .right.> SplashScreenAdvanced : uses



' App layer
app -down-> EmployeeManagement : verwendet
app -down-> IdProvider : verwendet\n(2 Instanzen)

' GUI layer
GuiBorderPane .down.> app : verwendet
GuiBorderPane .down.> NavigationsController : verwendet
GuiBorderPane -down-> bottomBar : enthält
GuiBorderPane -down-> topNavigationBar : enthält

' Navigation
NavigationsController .down.> dashboardView : navigiert zu
NavigationsController .down.> calenderView : navigiert zu
NavigationsController .down.> employeeView : navigiert zu
NavigationsController .down.> logView : navigiert zu
NavigationsController -right-> NavigationTarget : verwendet

' GUI Pages
bottomBar .down.> logger : liest Logs
dashboardView .down.> app : liest Daten
dashboardView .down.> logger : schreibt Logs
dashboardView .down.> WeekInfo : verwendet
dashboardView .down.> VacationStats : verwendet
calenderView .down.> app : liest/schreibt Daten
calenderView .down.> logger : schreibt Logs
employeeView .down.> app : liest/schreibt Daten
employeeView .down.> logger : schreibt Logs
logView .down.> logger : liest Logs

' Domain relationships (vertical)
EmployeeManagement "1" o-down- "0..*" Employee : verwaltet
Employee "1" *-down- "0..*" VacationEntry : enthält
VacationEntry *-down- "1" WeekRange : enthält


' Domain relationships (horizontal)
Employee -right-> Role : hat
Employee -right-> Department : hat
Employee -right-> Education : hat
VacationEntry -right-> VacationStatus : hat
EmployeeManagement -right-> OverlapStatus : berechnet


' Essential layer
IdProvider -down-> IdState : stellt wieder her
jsonReader .up.> Employee : erstellt
jsonReader .up.> config : konfiguriert
jsonReader .up.> EmployeeManagement : lädt
jsonWriter .up.> Employee : serialisiert
jsonWriter .up.> config : serialisiert
jsonWriter .up.> EmployeeManagement : speichert

' Logger relationships
logger -right-> LogEntry : erstellt
LogEntry -right-> Level : verwendet

' Cross-layer dependencies
jsonReader -up-> EmployeeManagement : lädt Daten
jsonWriter -up-> EmployeeManagement : speichert Daten


@enduml
